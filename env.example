# Clutch Hub API - environment overrides
# Copy this file to .env and adjust the values you need.
#
# How it works (src/hub/configuration.rs): config/<env>.toml is loaded first,
# then any environment variable with the APP_ prefix overrides the TOML key of
# the same name (APP_JWT_SECRET -> jwt_secret). `.env` is loaded via dotenv, so
# variables here behave exactly like process environment variables.
# All values are optional — unset variables fall back to the TOML config.

# --- Server ports ---
# Main HTTP/GraphQL bind address (/health, /graphql, /graphql/ws)
APP_WS_ADDR=0.0.0.0:3000
# Prometheus metrics server bind address (/metrics)
APP_SERVE_METRIC_ADDR=0.0.0.0:9090

# --- Clutch node connection ---
# WebSocket JSON-RPC endpoint of clutch-node
APP_CLUTCH_NODE_WS_URL=ws://127.0.0.1:8081/ws

# --- JWT auth ---
APP_JWT_SECRET=change-me-to-a-long-random-secret
APP_JWT_EXPIRATION_HOURS=6

# --- Logging / Seq ---
APP_LOG_LEVEL=info
APP_SEQ_URL=http://127.0.0.1:5341
APP_SEQ_API_KEY=

# --- Referrers injected by the Hub API (clients must not pass referrer) ---
APP_DEFAULT_RIDE_REQUEST_REFERRER=0x0912514c7cc3eec2b2dab4e1d150c4b5eaee5a6f
APP_DEFAULT_RIDE_OFFER_REFERRER=0x0912514c7cc3eec2b2dab4e1d150c4b5eaee5a6f
